[DEFAULT]
bantime  = 600
findtime = 600
maxretry = 3
action   = %(action_mwl)s
           discord

[sshd]
enabled = true
maxretry = 3
bantime = 3600

[nginx-botsearch]
enabled  = true
port     = http,https
filter   = nginx-botsearch
logpath  = /var/log/nginx/access.log
maxretry = 1
bantime  = 86400

[recidive]
enabled  = true
logpath  = /var/log/fail2ban.log
filter   = recidive
maxretry = 2
findtime = 86400
bantime  = 604800
protocol = tcp
